# Public repo: fetch over HTTPS so servers can pull without SSH/deploy keys,
# but push over SSH (only works on machines that have my key).
# Longest insteadOf match wins, so this overrides the global ssh rewrite.
[url "https://github.com/jacob-roberts/dotfiles"]
	insteadOf = https://github.com/jacob-roberts/dotfiles
[url "ssh://git@github.com/jacob-roberts/dotfiles"]
	pushInsteadOf = https://github.com/jacob-roberts/dotfiles
